# Copy to .env (git-ignored) and fill in. NO key ever lives in the repo.
# After the recent exposure, ROTATE every key below before pasting it here.

# --- Claude brain (optional) ---
ANTHROPIC_API_KEY=
ACHILLES_CLAUDE_MODEL=claude-opus-4-8

# --- Wake word ---
ACHILLES_WAKE_WORD=achilles
ACHILLES_WAKE_MIN_CONF=0.85
ACHILLES_WAKE_RMS_GATE=0.012
ACHILLES_WAKE_COOLDOWN_S=3.0
ACHILLES_SPEAKER_VERIFY=1
ACHILLES_SPEAKER_THRESHOLD=0.80
# Path to a downloaded Vosk model dir (empty = auto small en-us)
ACHILLES_VOSK_MODEL=

# --- WorldView ---
ACHILLES_WV_HOST=0.0.0.0
ACHILLES_WV_PORT=8590
# "south,west,north,east" or "global" to remove the Israel cap
ACHILLES_WV_BBOX=29.3,33.8,33.4,36.0
ACHILLES_WV_CENTER=31.5,34.9
ACHILLES_WV_ZOOM=7
ACHILLES_WV_AIRCRAFT_RADIUS_NM=250
# Used server-side only; tiles are proxied so the key never reaches a browser
OPENWEATHERMAP_API_KEY=

# --- Memory (Obsidian vault + tiered storage) ---
ACHILLES_VAULT_PATH=data/vault
ACHILLES_AUDIO_ARCHIVE=data/audio_archive
ACHILLES_DATA_DIR=data

# --- Integrations (all optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
MARANTZ_HOST=
MARANTZ_PORT=23
